    <!-- Configurazione iniziale -->
    <string name="welcome_short">Ti diamo il benvenuto</string>
    <string name="welcome_title">Allerte terremoto, secondi prima</string>
    <string name="welcome_body">Alertroid riceve le allerte terremoto che Google trasmette ai telefoni Android, direttamente e senza Google Play Services né un account Google, e ti avvisa prima che arrivino le scosse forti. Inoltra anche le altre allerte pubbliche per la tua zona.\n\nPer essere rapido e affidabile deve restare connesso in background, sapere più o meno dove ti trovi e poter suonare un allarme anche in modalità silenziosa.</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_body">A Google viene inviata solo la tua zona approssimativa (una cella di circa 40 km, mescolata con altri tre luoghi), insieme a un\'identità anonima del dispositivo. Nient\'altro viene inviato altrove, e non ci sono statistiche d\'uso.</string>
    <string name="permissions_intro">Consenti le voci necessarie per continuare. Quelle consigliate rendono gli avvisi più rapidi e più difficili da perdere.</string>
    <string name="perm_ok">Consentito</string>
    <string name="perm_required">Necessario</string>
    <string name="perm_recommended">Consigliato</string>
    <string name="grant">Consenti</string>
    <string name="continue_btn">Continua</string>
    <string name="done">Fatto</string>
    <string name="grant_required_first">Consenti le voci necessarie per continuare</string>
    <string name="vendor_title">Telefoni che chiudono le app in background</string>
    <string name="vendor_body">Alcuni produttori (Xiaomi, Huawei, Samsung, OnePlus, Oppo…) chiudono le app in background nonostante queste impostazioni. Se le allerte si interrompono, consenti anche l\'\"avvio automatico\" e disattiva ogni risparmio energetico specifico per Alertroid. dontkillmyapp.com spiega come fare per ogni telefono.</string>
    <string name="perm_notif">Notifiche</string>
    <string name="perm_notif_why">Per mostrare gli avvisi e mantenere attiva la connessione in background.</string>
    <string name="perm_loc">Posizione</string>
    <string name="perm_loc_why">Per sapere quale zona ascoltare e contare i secondi alle scosse. Si usa la posizione di rete; il GPS solo per poco e di rado, quando nient\'altro funziona.</string>
    <string name="perm_bgloc">Posizione sempre</string>
    <string name="perm_bgloc_why">Mantiene aggiornata la tua zona quando ti sposti, anche dopo un riavvio. Scegli \"Consenti sempre\".</string>
    <string name="perm_battery">Uso della batteria senza restrizioni</string>
    <string name="perm_battery_why">Mantiene aperta la connessione durante il sonno profondo e permette ad Alertroid di riavviarsi da solo. Senza, gli avvisi possono arrivare in ritardo o non arrivare.</string>
    <string name="perm_data">Dati in background</string>
    <string name="perm_data_why">Il Risparmio dati blocca i dati in background per questa app. Consenti l\'uso dei dati senza restrizioni perché le allerte arrivino.</string>
    <string name="perm_dnd">Accesso a Non disturbare</string>
    <string name="perm_dnd_why">Permette all\'allarme di suonare anche con Non disturbare attivo.</string>
    <string name="perm_fullscreen">Allerte a schermo intero</string>
    <string name="perm_fullscreen_why">Permette all\'avviso con mappa e conto alla rovescia di comparire sopra la schermata di blocco.</string>
    <string name="perm_overlay">Mostra sopra le altre app</string>
    <string name="perm_overlay_why">Permette all\'avviso di comparire subito, qualunque cosa tu stia facendo.</string>
    <string name="perm_alarms">Sveglie e promemoria</string>
    <string name="perm_alarms_why">Timer precisi controllano la connessione durante il sonno profondo e avviano in orario le allerte di prova.</string>
    <string name="ch_notice_always">Terremoto nella zona, anche in silenzioso</string>
    <string name="ch_notice_always_desc">Come "Terremoto nella zona", ma il suono si sente anche con il telefono in silenzioso o vibrazione (non con Non disturbare).</string>
