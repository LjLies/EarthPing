    <!-- Onboarding -->
    <string name="welcome_short">Welcome</string>
    <string name="welcome_title">Earthquake warnings, seconds ahead</string>
    <string name="welcome_body">EarthPing receives the earthquake alerts Google broadcasts for Android phones, directly and without Google Play Services or a Google account, and warns you before the strong shaking arrives. It also relays other public alerts for your area.\n\nTo be fast and reliable it has to stay connected in the background, know roughly where you are, and be allowed to sound an alarm even in silent mode.</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_body">Only your coarse area (a cell about 40 km wide, mixed with three other places) is sent to Google\'s push server, with an anonymous device identity. Nothing is sent anywhere else, and there are no analytics.</string>
    <string name="permissions_intro">Allow what is required to continue. The recommended items make warnings faster and harder to miss.</string>
    <string name="perm_ok">Allowed</string>
    <string name="perm_required">Required</string>
    <string name="perm_recommended">Recommended</string>
    <string name="grant">Allow</string>
    <string name="continue_btn">Continue</string>
    <string name="done">Done</string>
    <string name="grant_required_first">Allow the required items to continue</string>
    <string name="vendor_title">Phones that stop background apps</string>
    <string name="vendor_body">Some manufacturers (Xiaomi, Huawei, Samsung, OnePlus, Oppo…) stop background apps despite these settings. If alerts stop, also allow \"autostart\" and turn off any app-specific battery saver for EarthPing. dontkillmyapp.com explains how for each phone.</string>
    <string name="perm_notif">Notifications</string>
    <string name="perm_notif_why">To show warnings and keep the background connection running.</string>
    <string name="perm_loc">Location</string>
    <string name="perm_loc_why">To know which area to listen to and to count down to the shaking. Network location is used; GPS only briefly and rarely, when nothing else works.</string>
    <string name="perm_bgloc">Location all the time</string>
    <string name="perm_bgloc_why">Keeps your area up to date when you travel, including after a restart. Choose \"Allow all the time\".</string>
    <string name="perm_battery">Unrestricted battery use</string>
    <string name="perm_battery_why">Keeps the connection open during deep sleep and lets EarthPing restart itself. Without it, warnings can arrive late or not at all.</string>
    <string name="perm_data">Background data</string>
    <string name="perm_data_why">Data Saver blocks background data for this app. Allow unrestricted data so alerts arrive.</string>
    <string name="perm_dnd">Do Not Disturb access</string>
    <string name="perm_dnd_why">Lets the alarm sound through Do Not Disturb.</string>
    <string name="perm_fullscreen">Full-screen alerts</string>
    <string name="perm_fullscreen_why">Lets the warning with map and countdown appear over the lock screen.</string>
    <string name="perm_overlay">Display over other apps</string>
    <string name="perm_overlay_why">Lets the warning pop up at once, whatever you are doing.</string>
    <string name="perm_alarms">Alarms and reminders</string>
    <string name="perm_alarms_why">Precise timers check the connection during deep sleep and start test alerts on time.</string>
