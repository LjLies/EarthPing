    <string name="welcome_short">Selamat datang</string>
    <string name="welcome_title">Peringatan gempa, beberapa detik lebih awal</string>
    <string name="welcome_body">EarthPing menerima peringatan gempa yang disiarkan Google untuk ponsel Android, secara langsung dan tanpa Layanan Google Play atau akun Google, lalu memperingatkan Anda sebelum guncangan kuat tiba. Aplikasi ini juga meneruskan peringatan publik lain untuk daerah Anda.\n\nAgar cepat dan andal, aplikasi ini harus tetap terhubung di latar belakang, mengetahui kira-kira di mana Anda berada, dan diizinkan membunyikan alarm bahkan dalam mode senyap.</string>
    <string name="privacy_title">Privasi</string>
    <string name="privacy_body">Hanya area kasar Anda (sel selebar sekitar 40 km, dicampur dengan tiga tempat lain) yang dikirim ke server push Google, dengan identitas perangkat anonim. Tidak ada yang dikirim ke tempat lain, dan tidak ada analitik.</string>
    <string name="permissions_intro">Izinkan yang wajib untuk melanjutkan. Item yang disarankan membuat peringatan lebih cepat dan sulit terlewat.</string>
    <string name="perm_ok">Diizinkan</string>
    <string name="perm_required">Wajib</string>
    <string name="perm_recommended">Disarankan</string>
    <string name="grant">Izinkan</string>
    <string name="continue_btn">Lanjutkan</string>
    <string name="done">Selesai</string>
    <string name="grant_required_first">Izinkan item wajib untuk melanjutkan</string>
    <string name="vendor_title">Ponsel yang menghentikan aplikasi latar belakang</string>
    <string name="vendor_body">Beberapa produsen (Xiaomi, Huawei, Samsung, OnePlus, Oppo…) menghentikan aplikasi latar belakang meskipun setelan ini sudah diatur. Jika peringatan berhenti datang, izinkan juga “mulai otomatis” dan matikan penghemat baterai khusus aplikasi untuk EarthPing. dontkillmyapp.com menjelaskan caranya untuk setiap ponsel.</string>
    <string name="perm_notif">Notifikasi</string>
    <string name="perm_notif_why">Untuk menampilkan peringatan dan menjaga koneksi latar belakang tetap berjalan.</string>
    <string name="perm_loc">Lokasi</string>
    <string name="perm_loc_why">Untuk mengetahui area mana yang didengarkan dan menghitung mundur sampai guncangan. Lokasi jaringan digunakan; GPS hanya sebentar dan jarang, ketika tidak ada cara lain yang berhasil.</string>
    <string name="perm_bgloc">Lokasi sepanjang waktu</string>
    <string name="perm_bgloc_why">Menjaga area Anda tetap terbaru saat bepergian, termasuk setelah mulai ulang. Pilih “Izinkan sepanjang waktu”.</string>
    <string name="perm_battery">Penggunaan baterai tanpa batasan</string>
    <string name="perm_battery_why">Menjaga koneksi tetap terbuka selama tidur dalam dan memungkinkan EarthPing memulai ulang sendiri. Tanpa ini, peringatan bisa terlambat atau tidak datang sama sekali.</string>
    <string name="perm_data">Data latar belakang</string>
    <string name="perm_data_why">Penghemat Data memblokir data latar belakang untuk aplikasi ini. Izinkan data tanpa batasan agar peringatan sampai.</string>
    <string name="perm_dnd">Akses Jangan Ganggu</string>
    <string name="perm_dnd_why">Memungkinkan alarm berbunyi meskipun Jangan Ganggu aktif.</string>
    <string name="perm_fullscreen">Peringatan layar penuh</string>
    <string name="perm_fullscreen_why">Memungkinkan peringatan dengan peta dan hitung mundur muncul di atas layar kunci.</string>
    <string name="perm_overlay">Tampilkan di atas aplikasi lain</string>
    <string name="perm_overlay_why">Memungkinkan peringatan langsung muncul, apa pun yang sedang Anda lakukan.</string>
    <string name="perm_alarms">Alarm dan pengingat</string>
    <string name="perm_alarms_why">Pengatur waktu yang presisi memeriksa koneksi selama tidur dalam dan memulai peringatan uji tepat waktu.</string>
